# ── Neon DB credentials ───────────────────────────────────────────────────────
# Copy this file to .env and fill in your Neon project connection details.
# Never commit .env to version control.
#
# Find these in your Neon console:
#   https://console.neon.tech → your project → Connection Details
#   Select "JDBC" format to get the URL in the right form.

NEON_DB_URL=jdbc:postgresql://<host>.neon.tech/<dbname>?sslmode=require
NEON_DB_USER=<your-neon-username>
NEON_DB_PASSWORD=<your-neon-password>

# Local upload directory (defaults to ./uploads relative to where you run the app)
UPLOAD_DIR=./uploads

# Live Job Search Engine Strategy
JOB_API_ENABLED=true
JOB_API_PROVIDER=enterprise

# Optional — enable ClamAV scanning (requires a running clamd daemon)
# app.clamav.enabled=true
# app.clamav.host=localhost
# app.clamav.port=3310

